# ── Status site configuration ────────────────────────────────────────────────
# Documentation only. This static site has no server-side process and does not
# read this file at runtime. It records the values an operator must supply when
# wiring the page to real systems. Copy to .env for your own tooling if useful.

# ── Monitoring source (REQUIRED before the page can report real state) ───────
# The page is intentionally NOT connected. Until a health-check aggregator is
# wired up, data/status.json must keep "verified": false and the page reports
# "unknown"/"Not available". See README "The verification contract".
STATUS_API_URL=/api/status.json

# How often the front end re-reads the status endpoint, in seconds.
STATUS_REFRESH_INTERVAL=30

# Timezone used when rendering timestamps. "local" uses the visitor's locale.
TIMEZONE=local

# ── Email subscriptions (NOT IMPLEMENTED) ───────────────────────────────────
# No subscription service exists. The subscription form in index.html is
# rendered disabled and sends nothing. Do not enable it until an endpoint
# exists that can actually confirm and deliver notifications.
SUBSCRIPTION_EMAIL_ENDPOINT=
