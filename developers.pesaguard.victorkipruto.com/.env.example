# Required secrets: provide through the runtime secret manager; never commit values.
# Generate independent values with: openssl rand -base64 32
PESAGUARD_CREDENTIAL_HMAC_KEY=
PESAGUARD_AUDIT_HMAC_KEY=
# Set the pipeline API URL and the same random >=32-byte secret in both backends.
PESAGUARD_PIPELINE_KEY_SYNC_URL=
PESAGUARD_PIPELINE_KEY_SYNC_SECRET=
PESAGUARD_PIPELINE_KEY_SYNC_REQUIRED=true
# Required independent operator key.
PESAGUARD_OPERATOR_HMAC_KEY=
# Required Base64-encoded DER RSA key pair (PKCS#8 private, X.509 public).
PESAGUARD_JWT_KEY_ID=v1
PESAGUARD_JWT_PRIVATE_KEY=
PESAGUARD_JWT_PUBLIC_KEY=
PESAGUARD_ALLOWED_ORIGINS=http://localhost:5173
PESAGUARD_REGISTRATION_ENABLED=false
# WebAuthn relying-party trust settings; production must use your HTTPS portal origin.
PESAGUARD_WEBAUTHN_RP_ID=localhost
PESAGUARD_WEBAUTHN_RP_NAME=PesaGuard Developer Portal
PESAGUARD_WEBAUTHN_ORIGINS=http://localhost:5173
PESAGUARD_WEBAUTHN_CHALLENGE_TTL=PT3M

# Use Resend for developer-platform email. Set SMTP to use local Mailpit instead.
PESAGUARD_EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Configure this sender as a verified domain/sender in Resend.
PESAGUARD_MAIL_FROM=no-reply@pesaguard.co.ke
# Docker Compose uses the local Mailpit SMTP sink; for a backend run outside
# Compose, use MAIL_HOST=127.0.0.1 when Mailpit is bound to IPv4 loopback.
# Set a real SMTP relay and require STARTTLS before production use.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
# Mailpit is local and does not use TLS. Enable STARTTLS and authentication for
# a real SMTP relay.
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
MAIL_SMTP_READ_TIMEOUT_MS=10000
MAIL_SMTP_WRITE_TIMEOUT_MS=10000
PESAGUARD_EMAIL_VERIFICATION_URL=http://localhost:3000/
# Set to the monitored support-team mailbox before accepting support tickets.
SUPPORT_TICKET_EMAIL=support@pesaguard.co.ke

# Runtime operations controls. Disabled features are also denied by the API.
PESAGUARD_MAINTENANCE_MODE=false
PESAGUARD_MAINTENANCE_MESSAGE=The developer platform is temporarily unavailable while updates are being applied.
PESAGUARD_MAINTENANCE_STARTS_AT=
PESAGUARD_MAINTENANCE_RECOVERY_AT=
PESAGUARD_FEATURE_WEBHOOKS=true
PESAGUARD_FEATURE_EVENTS=true
PESAGUARD_FEATURE_USAGE=true
PESAGUARD_FEATURE_OAUTH=true
PESAGUARD_FEATURE_SANDBOX=true
PESAGUARD_FEATURE_PRODUCTION_ACCESS=true
PESAGUARD_FEATURE_SUPPORT=true
PESAGUARD_FEATURE_NOTIFICATIONS=true
PESAGUARD_FEATURE_BILLING=true
PESAGUARD_FEATURE_AUDIT=true
PESAGUARD_FEATURE_ORGANIZATION_EXPORT=true

# Direct backend configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/pesaguard_developer_platform
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Docker Compose PostgreSQL settings
POSTGRES_DB=pesaguard_developer_platform
POSTGRES_USER=postgres
