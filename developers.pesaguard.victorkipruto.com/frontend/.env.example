# Optional API URL override. Leave unset for local development so requests use
# the current browser hostname (localhost or the machine's LAN address) on port
# 8080. Set this only when the API is hosted at a different address.
# VITE_API_BASE_URL=http://localhost:8080

# Sign-in is enforced. Setting this to false opens the dashboard without a
# session, which is only useful for visual work on the UI itself; every request
# it makes will fail with 401 because no credential is attached.
VITE_AUTH_ENABLED=true