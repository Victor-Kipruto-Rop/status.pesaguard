# Deployment & Compose (required by infra/docker/docker-compose.yml)
POSTGRES_USER=pesaguard
POSTGRES_DB=pesaguard
REDIS_URL_DOCKER=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS_DOCKER=redpanda:9092
PESAGUARD_BIND_HOST_DOCKER=127.0.0.1
# Approved provider region identifiers (NOT logical labels).
DEPLOYMENT_REGION=
BACKUP_REGION=
LOG_REGION=
# Database & Storage
# Direct worker URL: least-privilege credentials restricted to iam_tenants(tenant_id, status).
PESAGUARD_TENANT_REGISTRY_DATABASE_URL=
# Compose override for the same registry-only role using Docker network hostnames.
PESAGUARD_TENANT_REGISTRY_DATABASE_URL_DOCKER=
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL_DOCKER=postgresql://pesaguard:replace-with-a-local-development-password@postgres:5432/pesaguard
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
# Retention approval API: inject the bearer token from the deployment secret manager.
PESAGUARD_RETENTION_APPROVAL_API_URL=https://approvals.example.invalid
PESAGUARD_RETENTION_APPROVAL_API_TOKEN=
PESAGUARD_ACCESS_TOKEN_TTL_MINUTES=15
JWT_ACTIVE_KID=current
JWT_KEYS_JSON={}
PESAGUARD_PAYLOAD_ENCRYPTION_KEY=
PESAGUARD_PAYLOAD_ENCRYPTION_KEY_PREVIOUS=
REDIS_URL=redis://localhost:6379/0
# Enable only on the dedicated scheduled-work process.
SCHEDULER_WORKER_MODE=0
SCHEDULER_POLL_SECONDS=15
PESAGUARD_SCHEDULER_HEARTBEAT_STALE_SECONDS=120
# Failed-login token buckets are account-, IP-, and device-scoped and use Redis in production.
PESAGUARD_LOGIN_ACCOUNT_RATE_LIMIT=5
PESAGUARD_LOGIN_IP_RATE_LIMIT=5
PESAGUARD_LOGIN_DEVICE_RATE_LIMIT=5
PESAGUARD_LOGIN_FAILURE_LIMIT=5
PESAGUARD_LOGIN_FAILURE_WINDOW_MINUTES=15
PESAGUARD_LOGIN_PROGRESSIVE_DELAY_BASE_SECONDS=1
PESAGUARD_LOGIN_PROGRESSIVE_DELAY_MAX_SECONDS=30
PESAGUARD_ACCOUNT_LOCKOUT_MINUTES=15
PESAGUARD_ACCOUNT_LOCKOUT_MAX_MINUTES=240
PESAGUARD_ACCOUNT_LOCKOUT_ESCALATION_RESET_HOURS=24
PESAGUARD_LOGIN_DETECTION_WINDOW_SECONDS=600
PESAGUARD_LOGIN_STUFFING_ACCOUNT_THRESHOLD=5
# Geo headers are ignored unless the ingress proxy is explicitly trusted.
PESAGUARD_TRUST_GEO_HEADERS=0
PESAGUARD_RISK_FAILED_ATTEMPT_THRESHOLD=3
# Tenant settings may override this authentication_risk_policy object.
PESAGUARD_AUTH_RISK_POLICY={"medium_threshold":0.35,"high_threshold":0.7,"medium_action":"require_mfa","high_action":"block","privileged_operation_requires_mfa":true,"unusual_login_minimum_samples":5,"unusual_login_hour_deviation":6,"impossible_travel_minimum_speed_kmh":900,"weights":{"new_device":0.2,"new_location":0.25,"impossible_travel":0.7,"unusual_login_time":0.2,"multiple_failed_attempts":0.25,"credential_compromise":0.8,"suspicious_ip":0.6,"high_risk_session":0.6,"privileged_operation":0.15},"suspicious_ip_cidrs":[],"compromised_ip_addresses":[]}
PESAGUARD_API_URL=https://api.pesaguard.co.ke
# Host path to the protected bearer-token file shared with Prometheus through a Compose secret.
PESAGUARD_PROMETHEUS_TOKEN_FILE=/absolute/path/to/dashboard_metrics_token
# Configure this file path in infra/.env.example. Keep the secret itself out of
# environment files; Compose mounts the protected file into Alertmanager and the receiver.
PESAGUARD_ALERTMANAGER_WEBHOOK_SECRET_FILE=/absolute/path/to/alertmanager_webhook_secret
# Include each browser app that calls the API; the status page and developer portal both need CORS access.
PESAGUARD_CORS_ALLOWED_ORIGINS=https://app.pesaguard.co.ke,https://docs.pesaguard.co.ke,https://developers.pesaguard.co.ke,https://status.pesaguard.co.ke,https://status.pesaguard.victorkipruto.com
# WebAuthn settings for the developer portal origin; production origins must be HTTPS.
PESAGUARD_WEBAUTHN_ORIGIN=https://developers.pesaguard.victorkipruto.com
PESAGUARD_WEBAUTHN_RP_ID=developers.pesaguard.victorkipruto.com
PESAGUARD_WEBAUTHN_RP_NAME=PesaGuard
# Generate a random value of at least 32 characters and set the same value as
# the GitHub Actions PESAGUARD_STATUS_MONITOR_TOKEN secret. Never commit it.
PESAGUARD_STATUS_MONITOR_TOKEN=
PESAGUARD_EVENT_STATE_REDIS_URL=redis://localhost:6379/1
PESAGUARD_EVENT_STATE_PREFIX=pesaguard:event-delivery
PESAGUARD_API_AUTH_REQUIRED=1
# Must match the Developer Platform's PESAGUARD_PIPELINE_KEY_SYNC_SECRET.
PESAGUARD_PIPELINE_KEY_SYNC_SECRET=
PESAGUARD_BIND_HOST=127.0.0.1

# Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
POSTGRES_ARCHIVE_COMMAND=test ! -f /var/lib/postgresql/wal_archive/%f && cp %p /var/lib/postgresql/wal_archive/%f
KAFKA_TOPIC_TRANSACTIONS=mpesa.transactions.raw
KAFKA_TOPIC_MATCHED=mpesa.transactions.matched
KAFKA_TOPIC_DISCREPANCIES=mpesa.discrepancies

# Tenant & Connector Settings
TENANT_ID=default
CONNECTOR_TYPE=postgres
INTERNAL_RECORDS_TABLE=orders
CONNECTOR_MAPPING_FILE=
REST_CONNECTOR_ENDPOINT=
REST_CONNECTOR_AUTH_TYPE=api_key
REST_CONNECTOR_AUTH_VALUE=
# For split-entry ledgers, map the distinct ledger row ID and shared payment reference.
# Example: {"internal_ref":"entry_id","reference":"invoice_ref","currency":"currency"}
POSTGRES_MAPPING=
GOOGLE_SHEETS_MAPPING=
REST_MAPPING=

# Notification Channels
SLACK_WEBHOOK_URL=
# SMTP email: supply provider credentials only in the ignored deployment file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@pesaguard.co.ke
SMTP_FROM_NAME=PesaGuard
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ALERT_EMAIL_FROM=no-reply@pesaguard.co.ke

# Reconciliation Parameters
RECONCILIATION_WINDOW_MINUTES=15
RQ_QUEUE_NAME=transaction_events
# Optional event-age threshold; stale data is reported as a warning, not quarantined.
# Leave blank to report freshness age without applying a threshold (historical backfills remain valid).
PESAGUARD_DQ_MAX_EVENT_AGE_SECONDS=

# Safaricom Daraja API Credentials (Sandbox / Production)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_daraja_consumer_key_here
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret_here
DARAJA_SHARED_SECRET=
# Dedicated HMAC-SHA256 key for raw Daraja callback bodies; do not reuse the OAuth consumer secret.
DARAJA_WEBHOOK_SIGNING_SECRET=
# Required for successful STK callbacks that omit BusinessShortCode from their callback metadata.
DARAJA_BUSINESS_SHORT_CODE=

# Encrypted off-site backup requirements for production
PESAGUARD_ENVIRONMENT=production
PESAGUARD_BACKUP_ENCRYPT_COMMAND=
PESAGUARD_BACKUP_UPLOAD_COMMAND=

# Africa's Talking communications (use sandbox credentials outside production)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SHORTCODE=
AFRICASTALKING_CALLBACK_BASE_URL=
AFRICASTALKING_WEBHOOK_SECRET=
AFRICASTALKING_TIMEOUT_SECONDS=10
AFRICASTALKING_MAX_RETRIES=5
PESAGUARD_COMMUNICATION_RETRY_BASE_SECONDS=5
PESAGUARD_COMMUNICATION_RETRY_MAX_SECONDS=600
PESAGUARD_COMMUNICATION_RETRY_JITTER=0.25

# Optional Sentry error reporting
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false
