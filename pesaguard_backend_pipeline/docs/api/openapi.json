{
  "openapi": "3.0.3",
  "info": {
    "title": "PesaGuard API",
    "version": "1.0.0",
    "description": "Tenant-scoped transaction, reconciliation, fraud, and authentication API. This file is the authoritative HTTP contract."
  },
  "x-api-contract-version": {
    "version": "1.0",
    "supported_versions": ["1.0"],
    "deprecated_versions": [],
    "migration": "/api/v1 remains stable; add /api/v2 for breaking changes."
  },
  "x-api-versioning": {
    "strategy": "URL major version",
    "versioned_path_patterns": ["/api/v{major}", "/v{major}"],
    "response_header": "X-API-Version",
    "breaking_change_policy": "Introduce a new major version and retain supported prior versions."
  },
  "servers": [{"url": "/api/v1"}],
  "security": [{"bearerAuth": []}],
  "tags": [{"name": "Transactions"}, {"name": "Reconciliation"}, {"name": "Fraud"}, {"name": "Authentication"}, {"name": "Operations"}],
  "paths": {
    "/transactions": {
      "post": {
        "tags": ["Transactions"], "summary": "Create or idempotently accept a transaction",
        "x-required-permission": "write:transactions",
        "security": [{"bearerAuth": []}, {"apiKeyAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/TenantHeader"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TransactionCreate"}}}},
        "responses": {"200": {"description": "Accepted or duplicate", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TransactionAccepted"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "409": {"$ref": "#/components/responses/Conflict"}, "429": {"$ref": "#/components/responses/RateLimited"}, "500": {"$ref": "#/components/responses/InternalError"}}
      }
    },
    "/transactions/{transaction_id}": {
      "get": {
        "tags": ["Transactions"], "summary": "Retrieve one tenant-scoped transaction", "x-required-permission": "read:transactions",
        "security": [{"bearerAuth": []}, {"apiKeyAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/TransactionId"}, {"$ref": "#/components/parameters/TenantHeader"}],
        "responses": {"200": {"description": "Transaction", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Transaction"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/transactions/{transaction_id}/status": {
      "get": {"tags": ["Transactions"], "summary": "Retrieve transaction lifecycle status", "x-required-permission": "read:transactions", "security": [{"bearerAuth": []}, {"apiKeyAuth": []}], "parameters": [{"$ref": "#/components/parameters/TransactionId"}, {"$ref": "#/components/parameters/TenantHeader"}], "responses": {"200": {"description": "Status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TransactionStatus"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}
    },
    "/transactions/search": {
      "get": {"tags": ["Transactions"], "summary": "Search tenant-scoped transactions", "x-required-permission": "read:transactions", "security": [{"bearerAuth": []}, {"apiKeyAuth": []}], "parameters": [{"$ref": "#/components/parameters/TenantHeader"}, {"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PerPage"}, {"$ref": "#/components/parameters/Sort"}, {"$ref": "#/components/parameters/Filter"}], "responses": {"200": {"description": "Paginated transactions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PaginatedTransactions"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}
    },
    "/reconciliation/requests": {
      "post": {"tags": ["Reconciliation"], "summary": "Request reconciliation", "x-required-permission": "write:transactions", "security": [{"bearerAuth": []}, {"apiKeyAuth": []}], "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/TenantHeader"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReconciliationRequest"}}}}, "responses": {"200": {"description": "Existing reconciliation result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReconciliationResult"}}}}, "202": {"description": "Queued", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReconciliationResult"}}}}, "409": {"$ref": "#/components/responses/Conflict"}, "default": {"$ref": "#/components/responses/Problem"}}}
    },
    "/reconciliation/{transaction_id}": {
      "get": {"tags": ["Reconciliation"], "summary": "Get reconciliation result and history", "x-required-permission": "read:transactions", "security": [{"bearerAuth": []}, {"apiKeyAuth": []}], "parameters": [{"$ref": "#/components/parameters/TransactionId"}, {"$ref": "#/components/parameters/TenantHeader"}], "responses": {"200": {"description": "Reconciliation result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReconciliationResult"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}
    },
    "/fraud/analyse": {
      "post": {"tags": ["Fraud"], "summary": "Analyse a tenant-scoped transaction synchronously", "x-required-permission": "write:transactions", "security": [{"bearerAuth": []}, {"apiKeyAuth": []}], "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/TenantHeader"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FraudAnalysisRequest"}}}}, "responses": {"200": {"description": "Persisted risk assessment", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RiskScore"}}}}, "409": {"$ref": "#/components/responses/Conflict"}, "default": {"$ref": "#/components/responses/Problem"}}}
    },
    "/fraud/{transaction_id}": {
      "get": {"tags": ["Fraud"], "summary": "Get risk score and anomalies", "x-required-permission": "read:transactions", "security": [{"bearerAuth": []}, {"apiKeyAuth": []}], "parameters": [{"$ref": "#/components/parameters/TransactionId"}, {"$ref": "#/components/parameters/TenantHeader"}], "responses": {"200": {"description": "Risk assessment", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RiskScore"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}
    },
    "/operations/scheduled-jobs": {
      "get": {"tags": ["Operations"], "summary": "List authenticated tenant scheduled jobs", "x-required-permission": "read:analytics", "x-user-authenticated-tenant": true, "security": [{"bearerAuth": []}], "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}], "responses": {"200": {"description": "Tenant scheduled-job status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScheduledJobList"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}}},
      "post": {"tags": ["Operations"], "summary": "Register an allow-listed reconciliation schedule", "x-required-permission": "manage:settings", "x-user-authenticated-tenant": true, "security": [{"bearerAuth": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScheduledJobCreate"}}}}, "responses": {"201": {"description": "Scheduled reconciliation job registered", "content": {"application/json": {"schema": {"type": "object"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "503": {"$ref": "#/components/responses/Problem"}}}
    },
    "/operations/scheduled-jobs/{job_key}/history": {
      "get": {"tags": ["Operations"], "summary": "Read tenant scheduled-job attempt history", "x-required-permission": "read:analytics", "x-user-authenticated-tenant": true, "security": [{"bearerAuth": []}], "parameters": [{"name": "job_key", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 255}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}}], "responses": {"200": {"description": "Tenant-scoped attempt history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScheduledJobHistory"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}}}
    },
    "/operations/scheduled-jobs/{job_key}/backfills": {
      "post": {"tags": ["Operations"], "summary": "Queue an idempotent bounded reconciliation backfill", "description": "Backfills reconcile already-ingested records in a UTC half-open time window; they do not retrieve missing provider history. Windows are limited to 366 days.", "x-required-permission": "manage:settings", "x-user-authenticated-tenant": true, "security": [{"bearerAuth": []}], "parameters": [{"name": "job_key", "in": "path", "required": true, "schema": {"type": "string", "maxLength": 255}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScheduledBackfillCreate"}}}}, "responses": {"202": {"description": "Backfill request durably queued", "content": {"application/json": {"schema": {"type": "object"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "503": {"$ref": "#/components/responses/Problem"}}}
    },
    "/operations/scheduled-runs/{run_id}/resolve": {
      "post": {"tags": ["Operations"], "summary": "Resolve an interrupted scheduled attempt", "description": "Retry requires remaining retry budget, a reason, and explicit confirmation that replay is idempotent. Skip records an audited operator decision.", "x-required-permission": "manage:settings", "x-user-authenticated-tenant": true, "security": [{"bearerAuth": []}], "parameters": [{"name": "run_id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScheduledRunResolve"}}}}, "responses": {"200": {"description": "Interrupted attempt resolution", "content": {"application/json": {"schema": {"type": "object"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "409": {"$ref": "#/components/responses/Conflict"}, "503": {"$ref": "#/components/responses/Problem"}}}
    },
    "/operations/dead-letters": {
      "get": {"tags": ["Operations"], "summary": "List tenant-scoped dead-letter metadata", "x-required-permission": "read:analytics", "x-user-authenticated-tenant": true, "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Page"}, {"$ref": "#/components/parameters/PerPage"}], "responses": {"200": {"description": "Tenant dead-letter page", "content": {"application/json": {"schema": {"type": "object"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}}}
    },
    "/operations/dead-letters/{dead_letter_id}/replay": {
      "post": {"tags": ["Operations"], "summary": "Request a reasoned tenant dead-letter replay", "description": "Replay is bounded to three attempts. Stale leases require operator inspection. A queued result is not proof of completed financial processing.", "x-required-permission": "resolve:discrepancies", "x-user-authenticated-tenant": true, "security": [{"bearerAuth": []}], "parameters": [{"name": "dead_letter_id", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeadLetterReplay"}}}}, "responses": {"200": {"description": "Replay durably queued", "content": {"application/json": {"schema": {"type": "object"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "403": {"$ref": "#/components/responses/Forbidden"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}, "503": {"$ref": "#/components/responses/Problem"}}}
    },
    "/auth/login": {
      "post": {"tags": ["Authentication"], "summary": "Authenticate a user", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}}, "responses": {"200": {"description": "Token pair", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenResponse"}}}}, "202": {"description": "Additional WebAuthn verification required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MfaChallenge"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "429": {"$ref": "#/components/responses/RateLimited"}}}
    },
    "/auth/refresh": {
      "post": {"tags": ["Authentication"], "summary": "Rotate a refresh token", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshRequest"}}}}, "responses": {"200": {"description": "Rotated token pair", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenResponse"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "429": {"$ref": "#/components/responses/RateLimited"}}}
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}, "apiKeyAuth": {"type": "apiKey", "in": "header", "name": "X-API-Key"}},
    "parameters": {
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 255}, "description": "Retries with the same key return the original durable result."},
      "TenantHeader": {"name": "X-Tenant-ID", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
      "TransactionId": {"name": "transaction_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
      "Page": {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "default": 1}},
      "PerPage": {"name": "per_page", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}},
      "Sort": {"name": "sort", "in": "query", "schema": {"type": "string", "default": "created_at:desc"}},
      "Filter": {"name": "filter", "in": "query", "schema": {"type": "string", "maxLength": 200}}
    },
    "schemas": {
      "ScheduledJobCreate": {"type": "object", "required": ["job_key", "interval_seconds", "timeout_seconds"], "properties": {"job_key": {"type": "string", "minLength": 1, "maxLength": 255}, "interval_seconds": {"type": "integer", "minimum": 1}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "first_run_at": {"type": "string", "format": "date-time"}, "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3}, "retry_backoff_seconds": {"type": "integer", "minimum": 1, "maximum": 3600, "default": 30}, "batch_size": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}, "depends_on": {"type": "array", "items": {"type": "string", "maxLength": 255}}}, "additionalProperties": false},
      "ScheduledJobList": {"type": "object", "required": ["tenant_id", "items", "limit"], "properties": {"tenant_id": {"type": "string"}, "limit": {"type": "integer"}, "items": {"type": "array", "items": {"type": "object", "required": ["job_key", "task_name", "enabled", "interval_seconds", "max_attempts", "retry_backoff_seconds", "run_count", "failure_count", "dependency_job_keys", "backfills"], "properties": {"job_key": {"type": "string"}, "task_name": {"type": "string", "enum": ["reconciliation.pending_transactions"]}, "enabled": {"type": "boolean"}, "interval_seconds": {"type": "integer"}, "timeout_seconds": {"type": ["integer", "null"]}, "max_attempts": {"type": "integer"}, "retry_backoff_seconds": {"type": "integer"}, "next_run_at": {"type": ["string", "null"], "format": "date-time"}, "retry_at": {"type": ["string", "null"], "format": "date-time"}, "last_run_at": {"type": ["string", "null"], "format": "date-time"}, "run_count": {"type": "integer"}, "failure_count": {"type": "integer"}, "latest_run_status": {"type": ["string", "null"]}, "dependency_job_keys": {"type": "array", "items": {"type": "string"}}, "backfills": {"type": "object", "additionalProperties": {"type": "integer"}}}}}}},
      "ScheduledJobHistory": {"type": "object", "required": ["tenant_id", "job_key", "items"], "properties": {"tenant_id": {"type": "string"}, "job_key": {"type": "string"}, "items": {"type": "array", "items": {"type": "object", "required": ["run_id", "scheduled_for", "started_at", "attempt", "trigger_type", "status"], "properties": {"run_id": {"type": "string"}, "scheduled_for": {"type": "string", "format": "date-time"}, "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": ["string", "null"], "format": "date-time"}, "attempt": {"type": "integer"}, "trigger_type": {"type": "string", "enum": ["scheduled", "backfill"]}, "backfill_id": {"type": ["string", "null"]}, "status": {"type": "string", "enum": ["running", "interrupted", "failed", "succeeded"]}, "error_type": {"type": ["string", "null"]}, "resolution_by": {"type": ["string", "null"]}, "resolution_reason": {"type": ["string", "null"]}, "worker_id": {"type": "string"}}}}}},
      "ScheduledBackfillCreate": {"type": "object", "required": ["start_at", "end_at", "idempotency_key", "reason"], "properties": {"start_at": {"type": "string", "format": "date-time"}, "end_at": {"type": "string", "format": "date-time"}, "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 255}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000}}, "additionalProperties": false},
      "ScheduledRunResolve": {"type": "object", "required": ["resolution", "reason"], "properties": {"resolution": {"type": "string", "enum": ["retry", "skip"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 2000}, "confirm_idempotent_replay": {"type": "boolean", "default": false}}, "additionalProperties": false},
      "DeadLetterReplay": {"type": "object", "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 2000}}, "additionalProperties": false},
      "TransactionCreate": {"type": "object", "anyOf": [{"required": ["provider_transaction_id", "provider_account_id"]}, {"required": ["TransID", "BusinessShortCode"]}], "required": ["provider", "TransAmount", "Currency", "MSISDN", "TransTime"], "properties": {"provider_transaction_id": {"type": "string"}, "provider_account_id": {"type": "string"}, "TransID": {"type": "string"}, "BusinessShortCode": {"type": ["string", "number"]}, "provider": {"type": "string"}, "TransAmount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"}, "Currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "MSISDN": {"type": "string"}, "TransTime": {"type": "string"}}, "additionalProperties": false},
      "Transaction": {"type": "object", "required": ["id", "tenant_id", "trans_id", "status", "trans_amount", "currency", "created_at"], "properties": {"id": {"type": "string"}, "tenant_id": {"type": "string"}, "trans_id": {"type": "string"}, "status": {"type": "string", "enum": ["RECEIVED", "VALIDATED", "PROCESSING", "RECONCILING", "RECONCILED", "FAILED", "REJECTED"]}, "trans_amount": {"type": "string"}, "currency": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}}},
      "TransactionAccepted": {"type": "object", "required": ["status", "duplicate"], "properties": {"status": {"type": "string"}, "duplicate": {"type": "boolean"}, "idempotency_key": {"type": "string"}}},
      "TransactionStatus": {"type": "object", "required": ["transaction_id", "status"], "properties": {"transaction_id": {"type": "string"}, "status": {"type": "string"}, "updated_at": {"type": "string", "format": "date-time"}}},
      "PaginatedTransactions": {"type": "object", "required": ["items", "page", "per_page", "total"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Transaction"}}, "page": {"type": "integer"}, "per_page": {"type": "integer"}, "total": {"type": "integer"}}},
      "ReconciliationRequest": {"type": "object", "required": ["transaction_id"], "properties": {"transaction_id": {"type": "string"}, "provider_account_id": {"type": "string"}, "force": {"type": "boolean", "default": false}}},
      "ReconciliationResult": {"type": "object", "required": ["transaction_id", "status"], "properties": {"transaction_id": {"type": "string"}, "status": {"type": "string", "enum": ["pending", "processing", "matched", "partial", "mismatch", "unmatched", "failed"]}, "job_id": {"type": "string"}, "exceptions": {"type": "array", "items": {"$ref": "#/components/schemas/Exception"}}, "history": {"type": "array", "items": {"type": "object"}}}},
      "Exception": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "severity": {"type": "string"}}},
      "FraudAnalysisRequest": {"type": "object", "required": ["transaction_id"], "properties": {"transaction_id": {"type": "string"}, "features": {"type": "object", "maxProperties": 0, "description": "Reserved; risk features are derived from trusted transaction history."}}},
      "RiskScore": {"type": "object", "required": ["transaction_id", "risk_score", "risk_level"], "properties": {"transaction_id": {"type": "string"}, "risk_score": {"type": "number", "minimum": 0, "maximum": 1}, "risk_level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "anomalies": {"type": "array", "items": {"type": "string"}}}},
      "LoginRequest": {"type": "object", "required": ["username", "password"], "properties": {"username": {"type": "string"}, "password": {"type": "string", "format": "password"}, "tenant_id": {"type": "string"}, "device_id": {"type": "string"}, "mfa_code": {"type": "string"}}},
      "RefreshRequest": {"type": "object", "required": ["refresh_token"], "properties": {"refresh_token": {"type": "string", "writeOnly": true}, "device_id": {"type": "string"}}},
      "TokenResponse": {"type": "object", "required": ["access_token", "refresh_token", "token_type", "expires_in"], "properties": {"access_token": {"type": "string", "readOnly": true}, "refresh_token": {"type": "string", "readOnly": true}, "token_type": {"type": "string", "example": "Bearer"}, "expires_in": {"type": "integer"}}},
      "MfaChallenge": {"type": "object", "required": ["status", "challenge_id", "challenge_type", "options", "expires_in"], "properties": {"status": {"type": "string", "const": "mfa_challenge_required"}, "challenge_id": {"type": "string"}, "challenge_type": {"type": "string", "const": "webauthn"}, "options": {"type": "object"}, "expires_in": {"type": "integer"}}},
      "Error": {"type": "object", "required": ["type", "title", "status", "detail", "instance", "code", "request_id"], "properties": {"type": {"type": "string", "format": "uri-reference"}, "title": {"type": "string"}, "status": {"type": "integer"}, "detail": {"type": "string"}, "instance": {"type": "string", "format": "uri-reference"}, "code": {"type": "string"}, "request_id": {"type": "string"}, "error": {"type": "string"}, "message": {"type": "string"}, "status_code": {"type": "integer"}, "details": {"type": "object"}}}
    },
    "responses": {
      "BadRequest": {"description": "Validation failure", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unauthorized": {"description": "Authentication required or invalid", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Forbidden": {"description": "Tenant or permission denied", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "Resource not found", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Conflict": {"description": "Idempotency or state conflict", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "RateLimited": {"description": "Rate limit exceeded", "headers": {"Retry-After": {"schema": {"type": "integer"}}}, "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "InternalError": {"description": "Internal processing failure", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Problem": {"description": "API error", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    }
  }
}