[Unit]
Description=PesaGuard Scheduled Reports Runner
After=network.target

[Service]
Type=oneshot
User=pesaguard
Group=pesaguard
WorkingDirectory=/opt/pesaguard
EnvironmentFile=/etc/pesaguard/.env
ExecStart=/usr/bin/env python3 /opt/pesaguard/pesaguard_backend_pipeline/scheduled_reports.py --tenant all --days 1 --type daily

[Install]
WantedBy=multi-user.target
